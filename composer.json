{
  "name": "iceboxind/craft-downtoll",
  "description": "Gated downloads and lead capture for Craft CMS.",
  "type": "craft-plugin",
  "keywords": ["craft", "craft-cms", "craft-plugin", "gated-content", "lead-capture", "downloads"],
  "license": "proprietary",
  "support": {
    "email": "support@iceboxind.com",
    "issues": "https://github.com/dgaidula/craft-downtoll/issues",
    "source": "https://github.com/dgaidula/craft-downtoll",
    "docs": "https://github.com/dgaidula/craft-downtoll/blob/main/README.md"
  },
  "require": {
    "php": ">=8.2",
    "craftcms/cms": "^5.0"
  },
  "require-dev": {
    "php-cs-fixer/shim": "^3"
  },
  "scripts": {
    "cs-check": "php-cs-fixer fix --dry-run --diff",
    "cs-fix": "php-cs-fixer fix"
  },
  "autoload": {
    "psr-4": {
      "iceboxind\\downtoll\\": "src/"
    }
  },
  "extra": {
    "handle": "downtoll",
    "name": "Downtoll",
    "editions": [
      "lite",
      "pro"
    ],
    "developer": "Danniel T. Gaidula",
    "developerUrl": "https://iceboxind.com",
    "documentationUrl": "https://github.com/dgaidula/craft-downtoll/blob/main/README.md",
    "class": "iceboxind\\downtoll\\Plugin"
  }
}
